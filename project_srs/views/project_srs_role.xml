<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_srs_role_view_form" model="ir.ui.view">
        <field name="name">project_srs_role_form</field>
        <field name="model">project.srs.role</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-archive" name="toggle_active" type="object">
                            <field name="active" widget="boolean_button" />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                    <group>
                        <field name="sequence" />
                    </group>
                    <group>
                        <field name="srs" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" options="{'post_refresh': 'recipients'}" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="project_srs_role_view_graph" model="ir.ui.view">
        <field name="name">project_srs_role_graph</field>
        <field name="model">project.srs.role</field>
        <field name="arch" type="xml">
            <graph string="Project srs role">
                <field name="name" type="row" />
                <field name="description" type="row" />
                <field name="sequence" type="measure" />
                <field name="srs" type="row" />
            </graph>
        </field>
    </record>

    <record id="project_srs_role_view_kanban" model="ir.ui.view">
        <field name="name">project_srs_role_kanban</field>
        <field name="model">project.srs.role</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="description" />
                <field name="sequence" />
                <field name="srs" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="description" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="sequence" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="srs" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_srs_role_view_pivot" model="ir.ui.view">
        <field name="name">project_srs_role_pivot</field>
        <field name="model">project.srs.role</field>
        <field name="arch" type="xml">
            <pivot string="Project srs role">
                <field name="name" type="row" />
                <field name="description" type="row" />
                <field name="sequence" type="measure" />
                <field name="srs" type="row" />
            </pivot>
        </field>
    </record>

    <record id="project_srs_role_view_search" model="ir.ui.view">
        <field name="name">project_srs_role_search</field>
        <field name="model">project.srs.role</field>
        <field name="arch" type="xml">
            <search string="Project srs role">
                <filter domain="[('name','!=',False)]" name="name" string="R&#244;le" />
                <filter domain="[('active','=',False)]" name="Inactive" string="Inactive Project srs role" />
                <filter domain="[('description','!=',False)]" name="description" string="Description" />
                <filter domain="[('sequence','!=',False)]" name="sequence" string="S&#233;quence" />
                <filter domain="[('srs','!=',False)]" name="srs" string="SRS" />
            </search>
        </field>
    </record>

    <record id="project_srs_role_view_tree" model="ir.ui.view">
        <field name="name">project_srs_role_tree</field>
        <field name="model">project.srs.role</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="description" />
                <field name="sequence" />
                <field name="srs" />
            </tree>
        </field>
    </record>

    <act_window
        id="project_srs_role_srs_role_action_window"
        name="Srs role"
        res_model="project.srs.role"
        view_mode="kanban,tree,pivot,graph,form,activity"
    />
</odoo>
